# Server Runtime & Observability Configuration (Twelve-Factor App)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_DIR=./logs
GIT_SHA=v1.0.0

# Security & Rate Limiting
# Comma-separated list of allowed WebSocket origins (empty = same-origin + localhost; * = any)
ALLOWED_ORIGINS=
MAX_CONNECTIONS_PER_IP=20
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD_BYTES=4096
RATE_LIMIT_PER_SEC=15
INPUT_RATE_LIMIT_PER_SEC=90
MAX_BUFFERED_AMOUNT=65536
JOIN_TIMEOUT_MS=5000
HEARTBEAT_INTERVAL_MS=15000
SHUTDOWN_TIMEOUT_MS=8000
