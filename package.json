{
  "name": "dogfight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "start": "npm --workspace=server run start",
    "build": "npm --workspace=client run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "lint": "tsx server/scripts/check-syntax.ts",
    "bots": "tsx server/scripts/run-bots.ts",
    "bench:browser": "tsx server/scripts/bench-browser.ts",
    "bench:report": "tsx server/scripts/bench-report.ts",
    "bench:collisions": "tsx server/scripts/bench-collisions.ts",
    "bench:netcode": "tsx server/scripts/bench-netcode.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.3",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5",
    "zod": "^3.23.0"
  }
}
